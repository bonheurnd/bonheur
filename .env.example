# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Authentication
JWT_SECRET="replace-with-secure-random-jwt-secret-in-production"
ADMIN_EMAIL="lalumierechoir@gmail.com"
ADMIN_PASSWORD=""

# Render Persistent Storage & Deployment
# When using Render Persistent Disk (e.g. mounted at /var/data or /data):
DATA_DIR="./data"
DATABASE_PATH="./data/lalumiere.db"
RENDER_EXTERNAL_URL=""
PORT="3000"

# Email Delivery (SMTP for Password Reset & Member Notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false" # "true" for port 465, "false" for port 587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"La Lumiere Choir" <noreply@lalumierechoir.rw>'

# -------------------------------------------------------------
# DIRECT RWANDA PAYMENT GATEWAY CONFIGURATION
# -------------------------------------------------------------
# Mode: "test" for development/sandbox, "live" for real production donations
PAYMENT_ENV="test" # "test" or "live"
PAYMENT_GATEWAY_PROVIDER="paypack" # "paypack", "mtn-momo", or "direct-rwandapay"

# Option A: Paypack Rwanda Gateway (Recommended for unified MTN MoMo & Airtel Money direct push)
# Obtain credentials from Paypack merchant portal (https://payments.paypack.rw)
PAYPACK_CLIENT_ID=""
PAYPACK_CLIENT_SECRET=""
PAYPACK_WEBHOOK_SECRET=""
PAYPACK_ENVIRONMENT="development" # "development" or "production"

# Option B: MTN MoMo OpenAPI Collections Rwanda
# Obtain credentials from MTN MoMo Developer Portal (https://momodeveloper.mtn.com)
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER_ID=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENVIRONMENT="sandbox" # "sandbox" or "live"
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com" # "https://proxy.momoapi.mtn.com" in production

# Option C: Airtel Money OpenAPI Rwanda
AIRTEL_MONEY_CLIENT_ID=""
AIRTEL_MONEY_CLIENT_SECRET=""
AIRTEL_MONEY_ENVIRONMENT="sandbox" # "sandbox" or "production"

# Webhook Callback Endpoint:
# In Render production, configure your payment provider webhook URL to:
# https://YOUR-RENDER-APP.onrender.com/api/payments/webhook

