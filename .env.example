# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Authentication
JWT_SECRET="replace-with-secure-random-jwt-secret-in-production"
ADMIN_EMAIL="lalumierechoir@gmail.com"
ADMIN_PASSWORD=""

# Render Persistent Storage & Deployment
# When using Render Persistent Disk (e.g. mounted at /var/data or /data):
DATA_DIR="./data"
DATABASE_PATH="./data/lalumiere.db"
RENDER_EXTERNAL_URL=""
PORT="3000"

# Email Delivery (SMTP for Password Reset & Member Notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false" # "true" for port 465, "false" for port 587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"La Lumiere Choir" <noreply@lalumierechoir.rw>'

# Rwanda Mobile Money (MTN MoMo Open API Rwanda)
MTN_MOMO_ENVIRONMENT="sandbox" # "sandbox" or "production"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER_ID=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENVIRONMENT="sandbox"

# Rwanda Airtel Money OpenAPI
AIRTEL_MONEY_ENVIRONMENT="sandbox" # "sandbox" or "production"
AIRTEL_MONEY_CLIENT_ID=""
AIRTEL_MONEY_CLIENT_SECRET=""

